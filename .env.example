# Alibaba Cloud Bailian / Qwen OpenAI-compatible API
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ROUTING_ENABLED=true
QWEN_MODEL=qwen3.7-plus
QWEN_MODEL_ANALYSIS=qwen3.8-flash
QWEN_MODEL_SAFETY=qwen3.7-plus
QWEN_MODEL_LANGUAGE=qwen3.8-flash
QWEN_MODEL_DEEP=qwen3.8-max

# Existing application variables
MIDNIGHT_DATABASE_URL=
# Railway and local fallback only
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=

# Email verification delivery
# Preferred for Railway: Gmail via Google Apps Script HTTPS Web App
GOOGLE_MAIL_SCRIPT_URL=
GOOGLE_MAIL_SCRIPT_SECRET=

# SMTP fallback (not recommended on Railway when Gmail ports are blocked)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
